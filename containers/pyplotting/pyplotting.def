BootStrap: docker
From: python:3.11-slim

%labels
    Description ""

%files
    pyplotting.def /opt/pyplotting/pyplotting.def

%post
    set -eux

    apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        build-essential \
        less \
        vim \
        nano \
        procps \
        wget \
        curl \
        ca-certificates \
        time && \
        rm -rf /var/lib/apt/lists/*

    # Install other dependencies
    pip install matplotlib seaborn numpy pandas umap-learn scikit-learn biopython

%environment
    export PATH="/usr/local/bin:$PATH"

%runscript
    exec "$@"





