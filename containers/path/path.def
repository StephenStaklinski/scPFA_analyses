Bootstrap: docker
From: rocker/r-ver:4.3.2

%labels
    Author Stephen_Staklinski
    Description "R container with PATH installed from landau-lab github / Schiffman et al. paper."

%environment
    export LC_ALL=C
    export LANG=C

%post
    apt-get update && apt-get install -y \
        build-essential \
        gfortran \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        libgit2-dev \
        git \
        time \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    R -e 'install.packages(c("remotes", "BiocManager", "qlcMatrix"), repos="https://cloud.r-project.org")'
    R -e 'BiocManager::install("fgsea", ask=FALSE, update=FALSE)'
    R -e 'remotes::install_github("landau-lab/PATH", dependencies=TRUE, upgrade="never")'
    R -e 'library(PATH)'

%runscript
    exec R "$@"